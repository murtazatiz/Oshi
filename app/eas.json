{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development",
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3000/api/v1"
      },
      "ios": {
        "simulator": true
      }
    },
    "staging": {
      "developmentClient": false,
      "distribution": "internal",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_API_BASE_URL": "https://oshi-staging.railway.app/api/v1"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.oshi.app/api/v1"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "[PLACEHOLDER]",
        "ascAppId": "[PLACEHOLDER]",
        "appleTeamId": "[PLACEHOLDER]"
      },
      "android": {
        "serviceAccountKeyPath": "[PLACEHOLDER]",
        "track": "production"
      }
    }
  }
}
