// ══════════════════════════════════════════════════════════════════════════════
// Oshi — Prisma Schema
// PRD §5.3 — all tables, columns, types, defaults, and relations
// Provider: PostgreSQL via Supabase
// DATABASE_URL must include ?pgbouncer=true for connection pooling (PRD §1.4)
// ══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL — Supabase connection string with PgBouncer for runtime queries.
//               Must include ?pgbouncer=true (PRD §1.4 — connection pooling).
// DIRECT_URL   — Supabase direct (non-pooled) connection for Prisma migrations.
//               PgBouncer transaction mode blocks the advisory locks that
//               `prisma migrate` requires, so migrations use this URL instead.
// Both are defined in backend/.env
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUM-LIKE string fields
//
// Supabase CHECK constraints (defined in the SQL schema) enforce valid values
// at the database level. Prisma does not duplicate those constraints, but the
// comments below document the allowed values so application code is clear.
// ─────────────────────────────────────────────────────────────────────────────

// subscription_status  : "free" | "trial" | "pro" | "cancelled"
// notification_permission: "not_asked" | "granted" | "denied"
// platform             : "instagram" | "youtube" | "tiktok" | "web" |
//                        "twitter" | "linkedin" | "spotify" | "other"
// content_type         : "short_video" | "long_video" | "article" | "podcast" |
//                        "post" | "product" | "image" | "other"
// processing_status    : "pending" | "processing" | "complete" | "failed"
// status (save)        : "unread" | "done" | "skipped"
// link_status          : "active" | "unavailable" | "private"
// action (signal)      : "opened" | "skipped" | "done"
// notification_type    : "daily_reminder" | "trial_expiry_warning" |
//                        "trial_expiry_day" | "reengagement"

// ─────────────────────────────────────────────────────────────────────────────
// MODEL: User
// PRD §5.3 — Table: users
// id is the Supabase Auth UUID — NOT auto-generated by Prisma.
// Set via @default(dbgenerated("gen_random_uuid()")) only as a fallback;
// in practice Supabase Auth populates this before the row is created.
// ─────────────────────────────────────────────────────────────────────────────
model User {
  /// UUID from Supabase Auth — matches auth.users(id)
  id String @id @db.Uuid

  email       String
  displayName String? @map("display_name")

  /// Supabase Storage signed URL — path: avatars/[user_id]/profile.jpg
  avatarUrl String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// "free" | "trial" | "pro" | "cancelled"   (PRD §5.3, §8)
  subscriptionStatus String   @default("free") @map("subscription_status")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at") @db.Timestamptz

  /// Daily reminder time stored as UTC (PRD §3.4.1). Postgres TIMETZ column.
  /// Stored as a String in Prisma (e.g. "19:00:00+00") — TIMETZ enforced by DB CHECK.
  reminderTime String @default("19:00:00+00") @map("reminder_time")

  /// ["mon","tue","wed","thu","fri","sat","sun"] — JSONB (PRD §5.3)
  reminderDays Json @default("[\"mon\",\"tue\",\"wed\",\"thu\",\"fri\",\"sat\",\"sun\"]") @map("reminder_days")

  timezone String @default("UTC")

  /// Duolingo-style hard-reset streak (PRD §3.4.4)
  streakCount           Int      @default(0)   @map("streak_count")
  streakLastEngagedDate DateTime? @map("streak_last_engaged_date") @db.Date

  /// Updated on every app open — used by smart notification logic (PRD §3.4.2)
  lastOpenedAt DateTime? @map("last_opened_at") @db.Timestamptz

  /// Expo push token (PRD §5.3)
  notificationToken      String? @map("notification_token")

  /// "not_asked" | "granted" | "denied"
  notificationPermission String  @default("not_asked") @map("notification_permission")

  /// True once the day-3 re-request modal has been shown (PRD §3.4.2)
  notificationReaskShown Boolean @default(false) @map("notification_reask_shown")

  /// Soft delete — set by DELETE /users/me. Purged after 30 days (PRD §3.7.5)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  /// Reset to 0 on 1st of each month by cron job (PRD §8.1)
  itemsSavedThisMonth Int @default(0) @map("items_saved_this_month")

  /// Set to NOW() on signup — used to calculate 7-day free trial expiry (PRD §8.1)
  trialStartedAt DateTime? @map("trial_started_at") @db.Timestamptz

  /// Set true by the trial_expiry_day BullMQ job so GET /users/me can signal
  /// the in-app banner (PRD §3.4.3). Cleared when user upgrades or trial resets.
  ///
  /// SQL migration required:
  ///   ALTER TABLE users ADD COLUMN IF NOT EXISTS
  ///     trial_expiry_banner_due BOOLEAN NOT NULL DEFAULT FALSE;
  trialExpiryBannerDue Boolean @default(false) @map("trial_expiry_banner_due")

  // ── Relations ──────────────────────────────────────────────────────────────
  categories         Category[]
  saves              Save[]
  engagementSignals  UserEngagementSignal[]
  notificationLogs   NotificationLog[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODEL: Category
// PRD §5.3 — Table: categories
// ─────────────────────────────────────────────────────────────────────────────
model Category {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  name  String
  emoji String @default("📌")

  /// Pro feature — nullable per-category reminder override time (PRD §3.7.2).
  /// Stored as a String (e.g. "08:00:00+00") — TIMETZ enforced by DB.
  reminderOverrideTime String? @map("reminder_override_time")

  sortOrder       Int     @default(0)   @map("sort_order")

  /// TRUE for the 11 AI-default categories seeded on signup (PRD §3.2.1)
  isSystemDefault Boolean @default(false) @map("is_system_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ── Relations ──────────────────────────────────────────────────────────────
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  saves Save[]

  @@map("categories")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODEL: Save
// PRD §5.3 — Table: saves
// ─────────────────────────────────────────────────────────────────────────────
model Save {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String  @map("user_id")     @db.Uuid
  categoryId String? @map("category_id") @db.Uuid

  url          String
  title        String?
  /// Max 300 chars — enforced by DB CHECK constraint in SQL schema
  summary      String?
  thumbnailUrl String? @map("thumbnail_url")

  /// "instagram"|"youtube"|"tiktok"|"web"|"twitter"|"linkedin"|"spotify"|"other"
  platform String?

  /// "short_video"|"long_video"|"article"|"podcast"|"post"|"product"|"image"|"other"
  contentType String? @map("content_type")

  /// AI-generated tags array stored as JSONB (PRD §3.2.1)
  tags Json @default("[]")

  creatorName         String? @map("creator_name")
  /// In seconds — for articles: word_count/3.33, for video: duration (PRD §3.2.1)
  estimatedTimeSeconds Int?   @map("estimated_time_seconds")
  aiConfidenceScore   Float?  @map("ai_confidence_score")

  /// "pending" | "processing" | "complete" | "failed"
  processingStatus String @default("pending") @map("processing_status")

  /// "unread" | "done" | "skipped"
  status    String    @default("unread")
  doneAt    DateTime? @map("done_at")    @db.Timestamptz
  skippedAt DateTime? @map("skipped_at") @db.Timestamptz

  userNote String? @map("user_note")

  savedAt   DateTime  @default(now()) @map("saved_at")  @db.Timestamptz
  viewedAt  DateTime?               @map("viewed_at") @db.Timestamptz

  /// "active" | "unavailable" | "private" — updated by dead link detection job (PRD §3.2.3)
  linkStatus String @default("active") @map("link_status")

  /// Nullable — populated only when user manually drag-reorders (PRD §3.3.7)
  manualSortOrder Int? @map("manual_sort_order")

  /// Soft delete — set by DELETE /saves/:id. Purged after 7 days by cron (API contract)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // ── Relations ──────────────────────────────────────────────────────────────
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  engagementSignals UserEngagementSignal[]

  @@map("saves")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODEL: UserEngagementSignal
// PRD §5.3 — Table: user_engagement_signals
// Feeds the AI smart sort scoring algorithm (PRD §3.2.2).
// ─────────────────────────────────────────────────────────────────────────────
model UserEngagementSignal {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  saveId String @map("save_id") @db.Uuid

  contentType String? @map("content_type")

  /// UUID stored as String — no FK enforced here since category may be deleted
  categoryId String? @map("category_id") @db.Uuid

  /// "opened" | "skipped" | "done"
  action    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // ── Relations ──────────────────────────────────────────────────────────────
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  save Save @relation(fields: [saveId], references: [id], onDelete: Cascade)

  @@map("user_engagement_signals")
}

// ─────────────────────────────────────────────────────────────────────────────
// MODEL: NotificationLog
// PRD §5.3 — Table: notification_logs
// Written by backend service role only (RLS: SELECT-only for users).
// ─────────────────────────────────────────────────────────────────────────────
model NotificationLog {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid

  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz

  /// "daily_reminder" | "trial_expiry_warning" | "trial_expiry_day" | "reengagement"
  notificationType String @map("notification_type")

  /// UUID of the category featured in the notification — nullable
  categoryId String? @map("category_id") @db.Uuid

  /// Number of unread items included in the notification body (PRD §3.4.1)
  itemCount Int? @map("item_count")

  /// Set to true via POST /notifications/log-open (API contract)
  opened   Boolean   @default(false)
  openedAt DateTime? @map("opened_at") @db.Timestamptz

  // ── Relations ──────────────────────────────────────────────────────────────
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_logs")
}
